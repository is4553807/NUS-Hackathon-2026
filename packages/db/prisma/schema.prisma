generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")

  @@map("merchant_status")
}

enum InventoryAvailability {
  IN_STOCK     @map("in_stock")
  LOW_STOCK    @map("low_stock")
  OUT_OF_STOCK @map("out_of_stock")

  @@map("inventory_availability")
}

enum CommerceDomain {
  RETAIL_GOODS           @map("retail_goods")
  SERVICES_SUBSCRIPTIONS @map("services_subscriptions")
  BOOKINGS               @map("bookings")

  @@map("commerce_domain")
}

enum ProductKind {
  PHYSICAL_GOOD   @map("physical_good")
  DIGITAL_PRODUCT @map("digital_product")
  SERVICE         @map("service")
  BOOKING         @map("booking")

  @@map("product_kind")
}

enum BillingModel {
  ONE_TIME    @map("one_time")
  RECURRING   @map("recurring")
  USAGE_BASED @map("usage_based")
  DEPOSIT     @map("deposit")

  @@map("billing_model")
}

enum AvailabilityModel {
  STOCK     @map("stock")
  UNLIMITED @map("unlimited")
  TIME_SLOT @map("time_slot")
  CAPACITY  @map("capacity")
  SEAT      @map("seat")

  @@map("availability_model")
}

enum CatalogImportStatus {
  PENDING    @map("pending")
  VALIDATING @map("validating")
  READY      @map("ready")
  IMPORTED   @map("imported")
  FAILED     @map("failed")

  @@map("catalog_import_status")
}

enum DigitalDeliveryMethod {
  DOWNLOAD       @map("download")
  LICENSE_KEY    @map("license_key")
  STREAMING      @map("streaming")
  ACCOUNT_ACCESS @map("account_access")

  @@map("digital_delivery_method")
}

enum ServiceDeliveryMode {
  IN_PERSON @map("in_person")
  REMOTE    @map("remote")
  HYBRID    @map("hybrid")

  @@map("service_delivery_mode")
}

enum OfferStatus {
  ACTIVE    @map("active")
  EXPIRED   @map("expired")
  ACCEPTED  @map("accepted")
  CANCELLED @map("cancelled")

  @@map("offer_status")
}

enum OrderStatus {
  PAYMENT_PENDING @map("payment_pending")
  PAID            @map("paid")
  PAYMENT_FAILED  @map("payment_failed")
  CANCELLED       @map("cancelled")

  @@map("order_status")
}

enum PaymentStatus {
  PENDING               @map("pending")
  REQUIRES_VERIFICATION @map("requires_verification")
  AUTHORIZED            @map("authorized")
  DECLINED              @map("declined")
  FAILED                @map("failed")
  CANCELLED             @map("cancelled")

  @@map("payment_status")
}

model Merchant {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(255)
  category     String?        @db.VarChar(255)
  description  String?
  currency     String         @default("SGD") @db.Char(3)
  contactEmail String?        @map("contact_email") @db.VarChar(255)
  status       MerchantStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  products        Product[]
  productVariants ProductVariant[]
  inventory       Inventory[]
  pricingPolicies PricingPolicy[]
  offers          Offer[]
  orders          Order[]
  importProfiles  MerchantImportProfile[]
  importJobs      CatalogImportJob[]

  @@index([category, status])
  @@map("merchants")
}

model Category {
  id                       String            @id @db.VarChar(180)
  parentId                 String?           @map("parent_id") @db.VarChar(180)
  domain                   CommerceDomain
  productKind              ProductKind       @map("product_kind")
  slug                     String            @db.VarChar(100)
  name                     String            @db.VarChar(255)
  level                    Int
  aliases                  String[]          @default([])
  defaultBillingModel      BillingModel      @default(ONE_TIME) @map("default_billing_model")
  defaultAvailabilityModel AvailabilityModel @default(STOCK) @map("default_availability_model")
  active                   Boolean           @default(true)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent         Category?               @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]              @relation("CategoryHierarchy")
  schemas        CategorySchema[]
  products       Product[]
  importProfiles MerchantImportProfile[]

  @@unique([parentId, slug])
  @@index([domain, active])
  @@index([parentId, active])
  @@map("categories")
}

model CategorySchema {
  id              String   @id @default(uuid()) @db.Uuid
  categoryId      String   @map("category_id") @db.VarChar(180)
  version         String   @db.VarChar(30)
  attributeSchema Json     @map("attribute_schema") @db.JsonB
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, version])
  @@index([categoryId, active])
  @@map("category_schemas")
}

model Product {
  id                String            @id @default(uuid()) @db.Uuid
  merchantId        String            @map("merchant_id") @db.Uuid
  externalId        String?           @map("external_id") @db.VarChar(255)
  categoryId        String            @map("category_id") @db.VarChar(180)
  productKind       ProductKind       @map("product_kind")
  billingModel      BillingModel      @default(ONE_TIME) @map("billing_model")
  availabilityModel AvailabilityModel @default(STOCK) @map("availability_model")
  name              String            @db.VarChar(255)
  description       String?
  brand             String?           @db.VarChar(255)
  basePrice         Decimal           @map("base_price") @db.Decimal(12, 2)
  currency          String            @default("SGD") @db.Char(3)
  imageUrl          String?           @map("image_url")
  attributes        Json              @default("{}") @db.JsonB
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant                 Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  category                 Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  physicalGoodDetails      PhysicalGoodDetails?
  digitalProductDetails    DigitalProductDetails?
  serviceDetails           ServiceDetails?
  bookingExperienceDetails BookingExperienceDetails?
  variants                 ProductVariant[]
  pricingPolicy            PricingPolicy?
  offers                   Offer[]
  orders                   Order[]

  @@unique([merchantId, externalId])
  @@index([merchantId, active])
  @@index([categoryId, brand, active])
  @@map("products")
}

model PhysicalGoodDetails {
  productId        String   @id @map("product_id") @db.Uuid
  weightGrams      Int?     @map("weight_grams")
  lengthCm         Decimal? @map("length_cm") @db.Decimal(8, 2)
  widthCm          Decimal? @map("width_cm") @db.Decimal(8, 2)
  heightCm         Decimal? @map("height_cm") @db.Decimal(8, 2)
  shippingRequired Boolean  @default(true) @map("shipping_required")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("physical_good_details")
}

model DigitalProductDetails {
  productId          String                @id @map("product_id") @db.Uuid
  deliveryMethod     DigitalDeliveryMethod @map("delivery_method")
  fileFormat         String?               @map("file_format") @db.VarChar(100)
  fileSizeBytes      BigInt?               @map("file_size_bytes")
  version            String?               @db.VarChar(100)
  licenseRequired    Boolean               @default(false) @map("license_required")
  accessDurationDays Int?                  @map("access_duration_days")
  fulfillmentUrl     String?               @map("fulfillment_url")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("digital_product_details")
}

model ServiceDetails {
  productId       String              @id @map("product_id") @db.Uuid
  serviceType     String              @map("service_type") @db.VarChar(150)
  deliveryMode    ServiceDeliveryMode @map("delivery_mode")
  durationMinutes Int                 @map("duration_minutes")
  location        String?
  serviceAreas    String[]            @default([]) @map("service_areas")
  providerName    String?             @map("provider_name") @db.VarChar(255)
  bookingRequired Boolean             @default(true) @map("booking_required")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("service_details")
}

model BookingExperienceDetails {
  productId       String   @id @map("product_id") @db.Uuid
  experienceType  String?  @map("experience_type") @db.VarChar(150)
  destination     String   @db.VarChar(255)
  venue           String?  @db.VarChar(255)
  startsAt        DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(3)
  timezone        String   @default("Asia/Singapore") @db.VarChar(100)
  capacity        Int
  minParticipants Int      @default(1) @map("min_participants")
  meetingPoint    String?  @map("meeting_point")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([destination, startsAt])
  @@map("booking_experience_details")
}

model ProductVariant {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @map("merchant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  externalId  String?  @map("external_id") @db.VarChar(255)
  sku         String?  @db.VarChar(150)
  name        String?  @db.VarChar(255)
  attributes  Json     @default("{}") @db.JsonB
  listedPrice Decimal  @map("listed_price") @db.Decimal(12, 2)
  imageUrl    String?  @map("image_url")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant  Merchant   @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory?
  offers    Offer[]

  @@unique([merchantId, sku])
  @@unique([merchantId, externalId])
  @@index([productId, active])
  @@map("product_variants")
}

model Inventory {
  id                String                @id @default(uuid()) @db.Uuid
  merchantId        String                @map("merchant_id") @db.Uuid
  variantId         String                @unique @map("variant_id") @db.Uuid
  quantityAvailable Int                   @default(0) @map("quantity_available")
  quantityReserved  Int                   @default(0) @map("quantity_reserved")
  availability      InventoryAvailability @default(IN_STOCK)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([merchantId, availability])
  @@map("inventory")
}

model PricingPolicy {
  id                       String   @id @default(uuid()) @db.Uuid
  merchantId               String   @map("merchant_id") @db.Uuid
  productId                String   @unique @map("product_id") @db.Uuid
  negotiationEnabled       Boolean  @default(false) @map("negotiation_enabled")
  minimumPrice             Decimal? @map("minimum_price") @db.Decimal(12, 2)
  maxDiscountPercent       Decimal? @map("max_discount_percent") @db.Decimal(5, 2)
  inventoryDiscountEnabled Boolean  @default(false) @map("inventory_discount_enabled")
  rules                    Json?    @db.JsonB
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("pricing_policies")
}

model Offer {
  id                String      @id @default(uuid()) @db.Uuid
  intentId          String      @map("intent_id") @db.Uuid
  merchantId        String      @map("merchant_id") @db.Uuid
  productId         String      @map("product_id") @db.Uuid
  variantId         String      @map("variant_id") @db.Uuid
  attributes        Json        @db.JsonB
  listedPrice       Decimal     @map("listed_price") @db.Decimal(12, 2)
  offeredPrice      Decimal     @map("offered_price") @db.Decimal(12, 2)
  currency          String      @default("SGD") @db.Char(3)
  quantity          Int         @default(1)
  deliveryAvailable Boolean     @default(true) @map("delivery_available")
  deliveryEstimate  DateTime?   @map("delivery_estimate") @db.Timestamptz(3)
  priceExplanation  String      @map("price_explanation")
  status            OfferStatus @default(ACTIVE)
  expiresAt         DateTime    @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product  Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  order    Order?

  // TODO(TIM integration): add the UserIntent relation after TIM's model lands.
  @@index([intentId, status, expiresAt])
  @@index([merchantId, status])
  @@index([productId, status])
  @@index([variantId, status])
  @@map("offers")
}

model MerchantImportProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  merchantId         String   @map("merchant_id") @db.Uuid
  categoryId         String   @map("category_id") @db.VarChar(180)
  name               String   @db.VarChar(255)
  schemaVersion      String   @map("schema_version") @db.VarChar(30)
  sourceHeaders      Json     @map("source_headers") @db.JsonB
  columnMapping      Json     @map("column_mapping") @db.JsonB
  normalizationRules Json?    @map("normalization_rules") @db.JsonB
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  jobs     CatalogImportJob[]

  @@unique([merchantId, name])
  @@index([merchantId, active])
  @@index([categoryId, active])
  @@map("merchant_import_profiles")
}

model CatalogImportJob {
  id               String              @id @default(uuid()) @db.Uuid
  merchantId       String              @map("merchant_id") @db.Uuid
  profileId        String?             @map("profile_id") @db.Uuid
  fileName         String              @map("file_name") @db.VarChar(255)
  sourceHeaders    Json                @map("source_headers") @db.JsonB
  status           CatalogImportStatus @default(PENDING)
  totalRows        Int                 @default(0) @map("total_rows")
  acceptedRows     Int                 @default(0) @map("accepted_rows")
  rejectedRows     Int                 @default(0) @map("rejected_rows")
  validationErrors Json?               @map("validation_errors") @db.JsonB
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(3)

  merchant Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  profile  MerchantImportProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([merchantId, status, createdAt])
  @@map("catalog_import_jobs")
}

model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  requestId           String      @unique @map("request_id") @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  merchantId          String      @map("merchant_id") @db.Uuid
  offerId             String      @unique @map("offer_id") @db.Uuid
  productId           String      @map("product_id") @db.Uuid
  quantity            Int         @default(1)
  unitPrice           Decimal     @map("unit_price") @db.Decimal(12, 2)
  totalAmount         Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency            String      @default("SGD") @db.Char(3)
  userConfirmed       Boolean     @map("user_confirmed")
  confirmedAt         DateTime    @map("confirmed_at") @db.Timestamptz(3)
  confirmationChannel String      @map("confirmation_channel") @db.VarChar(50)
  status              OrderStatus @default(PAYMENT_PENDING)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  offer    Offer     @relation(fields: [offerId], references: [id], onDelete: Restrict)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  payments Payment[]

  // TODO(TIM integration): add the User relation after TIM's model lands.
  @@index([userId, status, createdAt])
  @@index([merchantId, status, createdAt])
  @@map("orders")
}

model Payment {
  id                     String        @id @default(uuid()) @db.Uuid
  requestId              String        @unique @map("request_id") @db.Uuid
  orderId                String        @map("order_id") @db.Uuid
  provider               String        @default("Visa") @db.VarChar(100)
  amount                 Decimal       @db.Decimal(12, 2)
  currency               String        @default("SGD") @db.Char(3)
  paymentToken           String?       @map("payment_token")
  cardholderVerified     Boolean       @default(false) @map("cardholder_verified")
  status                 PaymentStatus @default(PENDING)
  authorizationReference String?       @map("authorization_reference") @db.VarChar(255)
  failureCode            String?       @map("failure_code") @db.VarChar(100)
  failureMessage         String?       @map("failure_message")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status, createdAt])
  @@map("payments")
}
