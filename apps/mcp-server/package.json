{
  "name": "@visa-commerce/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "dev:stdio": "MCP_TRANSPORT=stdio node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "start:stdio": "MCP_TRANSPORT=stdio node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@visa-commerce/commerce": "workspace:*",
    "@visa-commerce/contracts": "workspace:*",
    "zod": "4.5.2"
  }
}
